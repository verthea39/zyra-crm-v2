generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_NON_POOLING")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLog {
  id         String   @id
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())
  User       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Client {
  id                              String             @id
  clientType                      String
  accountStatus                   String             @default("PROSPECT")
  leadSource                      String             @default("OTHER")
  assignedPROId                   String?
  notes                           String?
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime
  User_Client_assignedPROIdToUser User?              @relation("Client_assignedPROIdToUser", fields: [assignedPROId], references: [id])
  CorporateProfile                CorporateProfile?
  Document                        Document[]
  IndividualProfile               IndividualProfile?
  Invoice                         Invoice[]
  LedgerEntry                     LedgerEntry[]
  Quotation                       Quotation[]
  User_User_clientIdToClient      User?              @relation("User_clientIdToClient")
  Workflow                        Workflow[]

  @@index([accountStatus])
  @@index([clientType])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model CorporateProfile {
  id                           String              @id
  clientId                     String              @unique
  companyNameEn                String
  companyNameAr                String?
  tradeLicenseNumber           String              @unique
  licenseType                  String?
  issuingAuthority             String
  legalType                    String?
  tradeLicenseExpiry           DateTime?
  establishmentCardImmNumber   String?
  establishmentCardImmExpiry   DateTime?
  establishmentCardMohreNumber String?
  establishmentCardMohreExpiry DateTime?
  corporateTaxTrn              String?
  vatTrn                       String?
  ejariNumber                  String?
  ejariExpiry                  DateTime?
  tenancyUnitDetails           String?
  authorizedSignatoryName      String?
  authorizedSignatoryPassport  String?
  authorizedSignatoryEid       String?
  authorizedSignatoryMobile    String?
  authorizedSignatoryEmail     String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime
  Client                       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  IndividualProfile            IndividualProfile[]

  @@index([issuingAuthority])
  @@index([tradeLicenseNumber])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Document {
  id                 String             @id
  clientId           String
  category           String
  fileName           String
  fileUrl            String
  mimeType           String?
  expiryDate         DateTime?
  verificationStatus String             @default("PENDING_REVIEW")
  uploadedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  Client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User               User?              @relation(fields: [uploadedById], references: [id])
  FieldTaskCheckIn   FieldTaskCheckIn[]

  @@index([category])
  @@index([clientId])
  @@index([expiryDate])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FieldTaskCheckIn {
  id         String    @id
  taskId     String
  userId     String
  latitude   Float?
  longitude  Float?
  note       String?
  documentId String?
  createdAt  DateTime  @default(now())
  Document   Document? @relation(fields: [documentId], references: [id])
  Task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  User       User      @relation(fields: [userId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model IndividualProfile {
  id               String            @id
  clientId         String            @unique
  fullNameEn       String
  fullNameAr       String?
  passportNumber   String
  nationality      String
  passportExpiry   DateTime?
  emiratesIdNumber String?
  emiratesIdExpiry DateTime?
  unifiedIdNumber  String?
  visaType         String?
  visaExpiry       DateTime?
  sponsorCompanyId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  Client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  CorporateProfile CorporateProfile? @relation(fields: [sponsorCompanyId], references: [id])

  @@index([emiratesIdNumber])
  @@index([passportNumber])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Invoice {
  id                       String            @id
  clientId                 String
  invoiceNumber            String            @unique
  issueDate                DateTime          @default(now())
  supplyDate               DateTime          @default(now())
  currency                 String            @default("AED")
  supplierTrn              String
  customerTrn              String?
  subtotalServiceFees      Decimal
  vatAmount                Decimal
  subtotalGovDisbursements Decimal
  totalPayable             Decimal
  paidAmount               Decimal           @default(0)
  balanceDue               Decimal
  status                   String            @default("DRAFT")
  createdById              String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime
  Client                   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  User                     User?             @relation(fields: [createdById], references: [id])
  InvoiceLineItem          InvoiceLineItem[]
  Payment                  Payment[]
  Quotation                Quotation?

  @@index([clientId])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceLineItem {
  id            String  @id
  invoiceId     String
  description   String
  type          String
  quantity      Decimal @default(1)
  unitPrice     Decimal
  vatRate       Decimal @default(0)
  lineTotal     Decimal
  govReceiptRef String?
  govReceiptUrl String?
  Invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LedgerEntry {
  id          String   @id
  clientId    String
  description String
  type        String
  debit       Decimal  @default(0)
  credit      Decimal  @default(0)
  createdAt   DateTime @default(now())
  Client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Payment {
  id        String   @id
  invoiceId String
  amount    Decimal
  method    String
  reference String?
  paidAt    DateTime @default(now())
  Invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Quotation {
  id                 String              @id
  clientId           String
  reference          String              @unique
  subtotal           Decimal
  vatAmount          Decimal
  total              Decimal
  status             String              @default("DRAFT")
  convertedInvoiceId String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  Client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  Invoice            Invoice?            @relation(fields: [convertedInvoiceId], references: [id])
  QuotationLineItem  QuotationLineItem[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model QuotationLineItem {
  id            String    @id
  quotationId   String
  description   String
  type          String
  quantity      Decimal   @default(1)
  unitPrice     Decimal
  govReceiptRef String?
  Quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Role {
  id          String   @id
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  User        User[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ServiceStepDef {
  id              String          @id
  templateId      String
  order           Int
  name            String
  description     String?
  ServiceTemplate ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ServiceTemplate {
  id             String           @id
  name           String
  category       String
  description    String?
  createdAt      DateTime         @default(now())
  basePrice      Decimal?
  ServiceStepDef ServiceStepDef[]
  Workflow       Workflow[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Task {
  id               String             @id
  workflowStepId   String?
  title            String
  venue            String
  status           String             @default("PENDING")
  assigneeId       String
  dueDate          DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  FieldTaskCheckIn FieldTaskCheckIn[]
  User             User               @relation(fields: [assigneeId], references: [id])
  WorkflowStep     WorkflowStep?      @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id                                String             @id
  name                              String
  email                             String             @unique
  passwordHash                      String?
  phone                             String?
  avatarUrl                         String?
  isActive                          Boolean            @default(true)
  roleId                            String
  clientId                          String?            @unique
  createdAt                         DateTime           @default(now())
  updatedAt                         DateTime
  AuditLog                          AuditLog[]
  Client_Client_assignedPROIdToUser Client[]           @relation("Client_assignedPROIdToUser")
  Document                          Document[]
  FieldTaskCheckIn                  FieldTaskCheckIn[]
  Invoice                           Invoice[]
  Task                              Task[]
  Client_User_clientIdToClient      Client?            @relation("User_clientIdToClient", fields: [clientId], references: [id])
  Role                              Role               @relation(fields: [roleId], references: [id])
  WorkflowStep                      WorkflowStep[]

  @@index([email])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Workflow {
  id              String           @id
  clientId        String
  templateId      String?
  name            String
  category        String
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ServiceTemplate ServiceTemplate? @relation(fields: [templateId], references: [id])
  WorkflowStep    WorkflowStep[]

  @@index([clientId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WorkflowStep {
  id                String    @id
  workflowId        String
  order             Int
  name              String
  status            String    @default("PENDING")
  assigneeId        String?
  fee               Decimal?
  icpGdrfaRefNumber String?
  tasheelRefNumber  String?
  mohreTxnNumber    String?
  dueDate           DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime
  Task              Task[]
  User              User?     @relation(fields: [assigneeId], references: [id])
  Workflow          Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([workflowId])
}
