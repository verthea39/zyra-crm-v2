// ============================================================================
// UAE Document Clearance / PRO Services / Business Setup CRM
// Prisma Schema — Step 1 Scaffold
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum TxnDirection {
  INCOME
  EXPENSE
}

enum TxnStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  PORTAL_BALANCE
  CHEQUE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  // Temporary for migration
  CASH
  BANK
  PORTAL
}

// ============================================================================
// AUTH & RBAC
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String?
  phone        String?
  avatarUrl    String?
  authId       String?
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  clientId String? @unique
  client   Client? @relation("ClientPortalUser", fields: [clientId], references: [id], onDelete: SetNull)

  assignedTasks     Task[]             @relation("AssignedPRO")
  assignedWorkflows WorkflowStep[]     @relation("StepAssignee")
  fieldTaskLogs     FieldTaskCheckIn[]
  documentsUploaded Document[]         @relation("UploadedBy")
  auditLogs         AuditLog[]
  invoices          Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedClients Client[] @relation("AssignedClientPRO")
  assignedLeads     Lead[]             @relation("LeadAssignee")
  assignedDeals     Deal[]             @relation("DealAssignee")
  createdActivities Activity[]         @relation("ActivityCreator")

  @@index([email])
}

// ============================================================================
// CLIENT & COMPANY MANAGEMENT
// ============================================================================

model Client {
  id            String @id @default(cuid())
  clientType    String
  accountStatus String @default("PROSPECT")
  leadSource    String @default("OTHER")

  code             String? // ZC-0001
  trn              String? // VAT registration number
  creditLimitFils  BigInt  @default(0)
  paymentTermsDays Int     @default(14)
  defaultCurrency  String  @default("AED")

  assignedPROId String?
  assignedPRO   User?   @relation("AssignedClientPRO", fields: [assignedPROId], references: [id])

  corporateProfile  CorporateProfile?
  individualProfile IndividualProfile?

  documents  Document[]
  workflows  Workflow[]
  quotations Quotation[]
  invoices   Invoice[]

  payments Payment[]
  cases    CaseFile[]
  deals    Deal[]
  activities Activity[]

  portalUser User? @relation("ClientPortalUser")

  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  journalLines JournalLine[]
  ledgerTransactions LedgerTransaction[]

  @@index([clientType])
  @@index([accountStatus])
}

model CorporateProfile {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  companyNameEn      String
  companyNameAr      String?
  tradeLicenseNumber String  @unique
  licenseType        String?
  issuingAuthority   String
  legalType          String?

  tradeLicenseExpiry DateTime?

  establishmentCardImmNumber   String?
  establishmentCardImmExpiry   DateTime?
  establishmentCardMohreNumber String?
  establishmentCardMohreExpiry DateTime?

  corporateTaxTrn String?
  vatTrn          String?

  ejariNumber        String?
  ejariExpiry        DateTime?
  tenancyUnitDetails String?

  authorizedSignatoryName     String?
  authorizedSignatoryPassport String?
  authorizedSignatoryEid      String?
  authorizedSignatoryMobile   String?
  authorizedSignatoryEmail    String?
  contactEmail                String?

  employees IndividualProfile[] @relation("SponsorCompany")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tradeLicenseNumber])
  @@index([issuingAuthority])
}

model IndividualProfile {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  fullNameEn String
  fullNameAr String?
  email      String?
  mobileNumber String?

  passportNumber String
  nationality    String
  passportExpiry DateTime?

  emiratesIdNumber String?
  emiratesIdExpiry DateTime?

  unifiedIdNumber String?
  visaType        String?
  visaExpiry      DateTime?

  sponsorCompanyId String?
  sponsorCompany   CorporateProfile? @relation("SponsorCompany", fields: [sponsorCompanyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passportNumber])
  @@index([emiratesIdNumber])
}

// ============================================================================
// PRO SERVICES / WORKFLOW TRACKER 
// ============================================================================

model ServiceTemplate {
  id          String           @id @default(cuid())
  name        String
  category    String
  description String?
  basePrice   Decimal?
  stepDefs    ServiceStepDef[]
  workflows   Workflow[]
  createdAt   DateTime         @default(now())
}

model ServiceStepDef {
  id          String          @id @default(cuid())
  template    ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId  String
  order       Int
  name        String
  description String?
}

model Workflow {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  template   ServiceTemplate? @relation(fields: [templateId], references: [id])
  templateId String?

  name     String
  category String
  steps    WorkflowStep[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowId String

  order  Int
  name   String
  status String @default("PENDING")

  assigneeId String?
  assignee   User?   @relation("StepAssignee", fields: [assigneeId], references: [id])

  fee Decimal?

  icpGdrfaRefNumber String?
  tasheelRefNumber  String?
  mohreTxnNumber    String?

  dueDate     DateTime?
  completedAt DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([status])
}

// ============================================================================
// FIELD PRO & TASK DISPATCH MODULE
// ============================================================================

model Task {
  id             String        @id @default(cuid())
  workflowStep   WorkflowStep? @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  workflowStepId String?

  title  String
  venue  String
  status String @default("PENDING")

  assigneeId String
  assignee   User   @relation("AssignedPRO", fields: [assigneeId], references: [id])

  dueDate DateTime?
  notes   String?

  checkIns FieldTaskCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
  @@index([workflowStepId])
}

model FieldTaskCheckIn {
  id     String @id @default(cuid())
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  latitude   Float?
  longitude  Float?
  note       String?
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  createdAt DateTime @default(now())
}

model Document {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  category String
  fileName String
  fileUrl  String
  mimeType String?

  expiryDate         DateTime?
  verificationStatus String    @default("PENDING_REVIEW")

  uploadedById String?
  uploadedBy   User?   @relation("UploadedBy", fields: [uploadedById], references: [id])

  fieldCheckIns FieldTaskCheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([category])
  @@index([expiryDate])
}

// ============================================================================
// QUOTATIONS
// ============================================================================

model Quotation {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  reference String              @unique // e.g. QTN-2026-0001
  lineItems QuotationLineItem[]

  subtotalMinor  BigInt
  vatAmountMinor BigInt
  totalMinor     BigInt

  status             String   @default("DRAFT")
  convertedInvoiceId String?  @unique
  invoice            Invoice? @relation(fields: [convertedInvoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId String

  description    String
  type           String
  quantity       Int     @default(1)
  unitPriceMinor BigInt  @default(0)
  govReceiptRef  String?

  @@index([quotationId])
}

model Invoice {
  id       String @id @default(cuid())
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  invoiceNumber                 String   @unique
  issueDate                     DateTime @default(now())
  supplyDate                    DateTime @default(now())
  currency                      String   @default("AED")
  supplierTrn                   String
  customerTrn                   String?
  subtotalServiceFeesMinor      BigInt
  vatAmountMinor                BigInt
  subtotalGovDisbursementsMinor BigInt
  totalPayableMinor             BigInt
  paidAmountMinor               BigInt   @default(0)
  balanceDueMinor               BigInt
  govReceiptUrl                 String?
  status                        String   @default("DRAFT")

  createdById String?
  user        User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems          InvoiceLineItem[]
  quotation          Quotation?
  paymentAllocations PaymentAllocation[]

  @@index([clientId, status, createdAt(sort: Desc)])
  @@index([status])
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  description    String
  type           String
  quantity       Int     @default(1)
  unitPriceMinor BigInt  @default(0)
  vatRate        Decimal @default(0)
  lineTotalMinor BigInt  @default(0)
  govReceiptRef  String?
  govReceiptUrl  String?

  @@index([invoiceId])
}

model Expense {
  id            String   @id @default(cuid())
  reference     String   @unique // e.g. EXP-2026-0001
  vendorName    String?
  description   String?
  
  amountMinor   BigInt
  taxMinor      BigInt   @default(0)
  totalMinor    BigInt
  paidMinor     BigInt   @default(0)
  balanceDueMinor BigInt @default(0)
  
  status        String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, VOID
  occurredAt    DateTime

  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentAllocations PaymentAllocation[]
}

// ============================================================================
// FINANCE & TRANSACTIONS (New Module)
// ============================================================================

model CaseFile {
  id            String    @id @default(cuid())
  code          String    @unique // ZR-2026-0142
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id])
  serviceType   String // "Residence visa renewal", "Trade licence renewal"
  applicantName String?
  status        String    @default("OPEN") // OPEN | SUBMITTED | COMPLETED | CANCELLED
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  @@index([clientId])
  @@index([status])
}

model Account {
  id                 String      @id @default(cuid())
  code               String      @unique // e.g., '1000', '4000'
  name               String      @unique
  type               AccountType
  isBank             Boolean     @default(false)
  currency           String      @default("AED")
  openingBalanceFils BigInt      @default(0)
  isActive           Boolean     @default(true)

  journalLines JournalLine[]
  payments     Payment[]
}

model JournalEntry {
  id           String        @id @default(cuid())
  entryDate    DateTime
  sourceType   String // e.g., 'INVOICE', 'PAYMENT', 'MANUAL'
  sourceId     String? // ID of the related document
  memo         String?
  reversedById String?       @unique
  reversedBy   JournalEntry? @relation("Reversals", fields: [reversedById], references: [id])
  reverses     JournalEntry? @relation("Reversals")

  lines     JournalLine[]
  createdAt DateTime      @default(now())
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])

  debitMinor  BigInt @default(0)
  creditMinor BigInt @default(0)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([clientId])
}

model Product {
  id              String  @id @default(cuid())
  name            String
  description     String?
  unitPriceMinor  BigInt
  taxCategoryId   String?
  incomeAccountId String
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id         String           @id @default(cuid())
  reference  String // RCT-2026-0001
  direction  PaymentDirection
  occurredAt DateTime
  mode       PaymentMode
  accountId  String
  account    Account          @relation(fields: [accountId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  amountMinor    BigInt
  unappliedMinor BigInt @default(0)

  chequeNo   String?
  chequeDate DateTime?
  notes      String?

  createdById String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  allocations PaymentAllocation[]

  @@index([occurredAt])
  @@index([clientId])
  @@index([accountId, occurredAt])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  amountMinor BigInt

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@unique([paymentId, expenseId])
  @@index([invoiceId])
  @@index([expenseId])
}

// ============================================================================
// AUDIT LOG
// ============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  reason    String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================================
// CRM & PIPELINE
// ============================================================================

model Lead {
  id             String   @id @default(cuid())
  name           String
  companyName    String?
  email          String?
  phone          String?
  serviceNeeded  String?
  status         String   @default("NEW") // NEW, CONTACTED, QUALIFIED, LOST
  source         String   @default("OTHER") // WHATSAPP, WEBSITE, REFERRAL
  notes          String?
  
  assignedToId   String?
  assignedTo     User?    @relation("LeadAssignee", fields: [assignedToId], references: [id])
  
  activities     Activity[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Deal {
  id             String   @id @default(cuid())
  title          String
  valueMinor     BigInt   @default(0)
  stage          String   @default("QUALIFIED") // QUALIFIED, PROPOSAL_SENT, GOV_PROCESSING, WON, LOST
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  expectedCloseDate DateTime?
  
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])

  assignedToId   String?
  assignedTo     User?    @relation("DealAssignee", fields: [assignedToId], references: [id])

  activities     Activity[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([stage])
  @@index([clientId])
}

model Activity {
  id             String   @id @default(cuid())
  type           String   // CALL, EMAIL, WHATSAPP, NOTE, MEETING
  description    String
  
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  dealId         String?
  deal           Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  createdById    String?
  createdBy      User?    @relation("ActivityCreator", fields: [createdById], references: [id])

  createdAt      DateTime @default(now())
  
  @@index([leadId])
  @@index([dealId])
  @@index([clientId])
}

// ============================================================================
// COCKPIT DASHBOARD (LEDGER)
// ============================================================================

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PAID
  PENDING
  OVERDUE
  PARTIALLY_PAID
  CANCELLED
}

model LedgerTransaction {
  id               String            @id @default(cuid())
  referenceId      String            @unique
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  counterpartyName String
  counterpartyPhone String?
  type             TransactionType
  category         String
  totalAmountMinor BigInt            @default(0) // Storing in minor units (fils) for precise calculation
  paidAmountMinor  BigInt            @default(0)
  balanceAmountMinor BigInt          @default(0) // We'll compute this in app logic since generated columns might be tricky depending on DB provider
  currency         String            @default("AED")
  status           TransactionStatus @default(PENDING)
  transactionDate  DateTime          @default(now())
  dueDate          DateTime?
  notes            String?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([transactionDate])
}

enum UserRole {
  VIEWER
  FINANCE_OPERATOR
  TREASURY_ADMIN
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model FinanceAuditLog {
  id              String       @id @default(uuid())
  transactionId   String?
  actorEmail      String
  action          AuditAction
  previousPayload Json?
  newPayload      Json?
  timestamp       DateTime     @default(now())

  @@index([transactionId])
  @@index([actorEmail])
}

