generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["v2"]
}

enum Role {
  ADMIN
  COORDINATOR
  // New Roles
  SUPER_ADMIN
  PRO_SPECIALIST
  TYPIST
  ACCOUNTANT
  @@schema("v2")
}

enum ClientType {
  INDIVIDUAL
  CORPORATE
  @@schema("v2")
}

enum CaseStage {
  PRE_CHECK
  SUBMITTED
  COMPLETED
  
  // New Pipeline Stages
  DRAFT_INTAKE
  OFFER_LETTER_MOHRE
  ENTRY_PERMIT
  MEDICAL_BIOMETRICS
  VISA_STAMPING_EID
  COMPLETED_HANDOVER
  @@schema("v2")
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
  @@schema("v2")
}

enum TransactionType {
  INCOME
  EXPENSE
  @@schema("v2")
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
  PARTIALLY_PAID
  @@schema("v2")
}

enum DocumentType {
  INVOICE
  QUOTATION
  RECEIPT
  @@schema("v2")
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  CONVERTED
  @@schema("v2")
}

model Document {
  id            String         @id @default(cuid())
  reference     String         @unique
  type          DocumentType
  status        DocumentStatus @default(DRAFT)

  clientId      String
  client        Client         @relation(fields: [clientId], references: [id])

  caseFileId    String?
  caseFile      CaseFile?      @relation(fields: [caseFileId], references: [id], onDelete: SetNull)

  items         DocumentItem[]

  subtotalMinor   Int          @default(0)
  discountMinor   Int          @default(0)
  vatRate         Float        @default(5)
  vatMinor        Int          @default(0)
  totalMinor      Int          @default(0)
  paidMinor       Int          @default(0)

  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  expiryDate    DateTime?
  notes         String?

  // Quotation -> Invoice conversion link. Set on the quotation, pointing at
  // the invoice document it was converted into.
  convertedInvoiceId     String?   @unique
  convertedInvoice       Document? @relation("QuotationToInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  convertedFromQuotation Document? @relation("QuotationToInvoice")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([clientId])
  @@index([caseFileId])
  @@index([type])
  @@index([status])
  @@schema("v2")
}

model DocumentItem {
  id             String   @id @default(cuid())
  documentId     String
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  description    String
  quantity       Int      @default(1)
  unitPriceMinor Int      @default(0)
  lineTotalMinor Int      @default(0)
  vatExempt      Boolean  @default(false)

  createdAt      DateTime @default(now())

  @@index([documentId])
  @@schema("v2")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  role         Role          @default(COORDINATOR)
  password     String?       // For initial auth if needed
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  lastLogin    DateTime?
  cases        CaseFile[]
  whatsappLogs WhatsAppLog[]
  auditLogs    AuditLog[]
  @@schema("v2")
}

model Client {
  id              String     @id @default(cuid())
  type            ClientType
  leadSource      String?
  name            String
  email           String?
  phone           String?
  place           String?
  nationality     String?
  visaType        String?
  passportNo      String?
  passportExpiry  DateTime?
  emiratesIdNo    String?
  tradeLicenseNo  String?
  expiryDate      DateTime?
  trnNumber           String?   // Corporate: Tax Registration Number
  establishmentCardNo String?   // Corporate: MOHRE Establishment Card No
  mohreQuotaTotal     Int?      @default(20) // Corporate: total MOHRE labour quota allocation
  createdAt       DateTime   @default(now())
  cases           CaseFile[]
  transactions    Transaction[]
  employees           Employee[]
  vaultDocuments      DocumentVault[]
  portalTransactions  PortalTransaction[]
  whatsappLogs        WhatsAppLog[]
  documents           Document[]

  @@index([type])
  @@index([expiryDate])
  @@schema("v2")
}

model CaseFile {
  id             String              @id @default(cuid())
  reference      String              @unique
  applicantName  String?
  mohreAppNo     String?
  gdrfaRequestNo String?
  serviceType    String
  stage          CaseStage           @default(DRAFT_INTAKE)
  stageUpdatedAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id])
  coordinatorId  String
  coordinator    User                @relation(fields: [coordinatorId], references: [id])
  documents      DocumentChecklist[]
  billingDocuments Document[]
  transactions   Transaction[]
  whatsappLogs   WhatsAppLog[]
  trackingToken  String?             @unique @default(uuid())

  @@index([clientId])
  @@index([coordinatorId])
  @@index([stage])
  @@index([trackingToken])
  @@schema("v2")
}

model DocumentChecklist {
  id         String    @id @default(cuid())
  title      String
  status     DocStatus @default(PENDING)
  caseFileId String
  caseFile   CaseFile  @relation(fields: [caseFileId], references: [id], onDelete: Cascade)

  @@index([caseFileId])
  @@index([status])
  @@schema("v2")
}

model Transaction {
  id              String            @id @default(cuid())
  reference       String            @unique // e.g. EXP-2026-018, INV-2026-042
  type            TransactionType
  date            DateTime          @default(now())
  dueDate         DateTime?
  counterparty    String            // Client name or Vendor name
  category        String            // e.g., "Meta Ad", "MOHRE Fee", "Service Charge"
  paymentMode     String?           // CASH, BANK_TRANSFER, CARD
  description     String?
  amountTotal     Int               // Minor units
  amountPaid      Int               @default(0)
  status          TransactionStatus @default(PENDING)
  
  // Dual-Bucket Strict Accounting (Only applies to Case Invoices)
  isCaseInvoice   Boolean           @default(false)
  govFeePart      Int?
  serviceFeePart  Int?
  lineItems       Json?

  
  caseFileId      String?
  caseFile        CaseFile?         @relation(fields: [caseFileId], references: [id], onDelete: SetNull)

  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)

  payments        TransactionPayment[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([date])
  @@schema("v2")
}

model TransactionPayment {
  id             String      @id @default(cuid())
  transactionId  String
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  amountMinor    Int
  method         String?
  transactionRef String?
  notes          String?

  paidAt         DateTime    @default(now())
  createdAt      DateTime    @default(now())

  @@index([transactionId])
  @@schema("v2")
}

model Employee {
  id             String    @id @default(cuid())
  name           String
  designation    String?
  basicSalary    Float?
  visaCategory   String?
  visaStatus     String?   @default("ACTIVE") // ACTIVE, PENDING, EXPIRED, CANCELLED
  passportNo     String?
  emiratesIdNo   String?
  expiryDate     DateTime? // Emirates ID / visa expiry
  corporateId    String
  corporate      Client    @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  documents      DocumentVault[]
  createdAt      DateTime  @default(now())
  
  @@index([corporateId])
  @@schema("v2")
}

model DocumentVault {
  id           String    @id @default(cuid())
  category     String    // Passports, UAE Visas, Emirates IDs, Trade Licenses, Ejari / Tenancy, Establishment Cards, Labor Cards
  title        String
  fileUrl      String?
  expiryDate   DateTime?
  
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  remarks      String?
  createdAt    DateTime  @default(now())
  @@schema("v2")
}

model PortalWallet {
  id                  String   @id @default(cuid())
  entityName          String   @unique // Tas-heel, Amer, ICP, DED
  balance             Float    @default(0)
  portalType          String?  // IMMIGRATION, LABOUR, ECONOMIC, GENERAL
  accountNumber       String?  // Portal login ref / account number
  lowBalanceThreshold Float    @default(500)
  lastTopUpDate       DateTime?
  lastUpdated         DateTime @updatedAt
  transactions PortalTransaction[]
  @@schema("v2")
}

model PortalTransaction {
  id             String        @id @default(cuid())
  walletId       String
  wallet         PortalWallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  type           String        // TOP_UP, DEDUCTION
  amount         Float
  balanceAfter   Float?
  
  receiptRef     String?
  caseRef        String?
  date           DateTime      @default(now())
  description    String?

  @@index([walletId])
  @@index([caseRef])
  @@index([clientId])
  @@schema("v2")
}

model WhatsAppLog {
  id           String    @id @default(cuid())
  caseId       String
  caseFile     CaseFile  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateType String
  phone        String
  sentById     String?
  sentBy       User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentAt       DateTime  @default(now())

  @@index([caseId])
  @@index([clientId])
  @@index([sentById])
  @@schema("v2")
}

model ServiceItem {
  id           String    @id @default(cuid())
  name         String    @unique
  category     String
  govFee       Float
  agencyFee    Float
  isVatExempt  Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@schema("v2")
}

model CompanySettings {
  id              String   @id @default(cuid()) // Expected to have only one row, e.g. "DEFAULT"
  companyNameEn   String?
  companyNameAr   String?
  trn             String?
  tradeLicenseNo  String?
  address         String?
  bankName        String?
  accountName     String?
  iban            String?
  swift           String?
  invoiceNotes    String?
  financePin      String?  // Store hashed or plain (depending on security reqs) - usually we'd hash, but for MVP plain/simple hash.
  phone           String?
  email           String?
  website         String?
  paymentTerms    String?
  logoUrl         String?
  updatedAt       DateTime @updatedAt
  @@schema("v2")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@schema("v2")
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "QUOTATION_CREATED", "INVOICE_ISSUED", "PAYMENT_RECORDED", "STATUS_UPDATED", "CLIENT_ADDED"
  title      String   // e.g. "Quotation #QT-2026-004 created for Look line Technical service Co LLC"
  details    Json?    // flexible metadata: amount, previousStatus, newStatus, documentId, etc.
  entityType String   // e.g. "QUOTATION", "INVOICE", "PAYMENT", "CLIENT", "CASE", "WALLET"
  entityId   String?
  actorName  String   @default("Admin User")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("v2")
}
